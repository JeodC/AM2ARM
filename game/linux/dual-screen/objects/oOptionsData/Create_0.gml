global.curropt = 0;
lastitem = os_type == os_linux ? 2 : 6;
active = 0;
alarm[0] = 5;
found1 = 0;
found2 = 0;
found3 = 0;
foundu = 0;
ingame = instance_exists(oSS_Control);
result_pending = 0;
result_action = "";
result_ok = 0;
result_files = 0;
event_user(0);
with (oSS_Fg) op_text1 = get_text("Misc", "DataMenu");
tip[0] = get_text("Misc", "BackupSaves_Tip");
if (ingame) tip[1] = get_text("Misc", "RestoreIngame_Tip");
else tip[1] = get_text("Misc", "RestoreSaves_Tip");
tip[2] = port_caption("Choose the folder your sync service uses.");
tip[3] = global.am2r_sync.message;
tip[4] = port_caption("Choose between conflicting progress at the title menu.");
tip[5] = port_caption("Turn off sync. Existing saves and shared files stay intact.");
tip[6] = get_text("GlobalOptions", "Exit_Tip");
if (os_type == os_linux) tip[2] = get_text("GlobalOptions", "Exit_Tip");
global.tiptext = tip[global.curropt];
