/// @description  calculateCollisionBounds()
function calculateCollisionBounds() {
	// Convert this instance's configured collision offsets into world-space probe bounds.
	lb = x + collisionBoundsOffsetLeftX;
	tb = y + collisionBoundsOffsetTopY;
	rb = x + collisionBoundsOffsetRightX;
	bb = y + collisionBoundsOffsetBottomY;



}
