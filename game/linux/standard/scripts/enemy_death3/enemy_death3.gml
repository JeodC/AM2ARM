	expl.additive = 0;
	expl.sprite_index = sExpl1;
	expl.image_xscale = 0.7;
	expl.image_yscale = 0.7;
	// Roll a resource drop and choose the larger explosion sound before the final cleanup.
	spawn_rnd_pickup(100);
	if(deathsound == sndEDeath1 || deathsound == sndEDeath2) PlaySoundMono(sndEDeath3);
	else PlaySoundMono(deathsound);
	if (instance_exists(platform)) with (platform) instance_destroy();
	global.kills += 1;

	instance_destroy();



