/// @description  enemy_death3()
function enemy_death3() {
	// Create the death effects in the defeated enemy's context, using its position and death sound.
	expl = instance_create(x, y, oFXAnimSpark);
	expl.image_speed = 0.5;
	expl.additive = 0;
	expl.sprite_index = sExpl1;
	expl = instance_create(x - 10, y - 10, oFXAnimSpark);
	expl.image_speed = 0.9;
	expl.additive = 0;
	expl.sprite_index = sExpl1;
	expl.image_xscale = 0.7;
	expl.image_yscale = 0.7;
	expl = instance_create(x + 10, y - 10, oFXAnimSpark);
	expl.image_speed = 0.9;
	expl.additive = 0;
	expl.sprite_index = sExpl1;
	expl.image_xscale = 0.7;
	expl.image_yscale = 0.7;
	expl = instance_create(x + 10, y + 10, oFXAnimSpark);
	expl.image_speed = 0.9;
	expl.additive = 0;
	expl.sprite_index = sExpl1;
	expl.image_xscale = 0.7;
	expl.image_yscale = 0.7;
	expl = instance_create(x - 10, y + 10, oFXAnimSpark);
	expl.image_speed = 0.9;
	expl.additive = 0;
	expl.sprite_index = sExpl1;
	expl.image_xscale = 0.7;
