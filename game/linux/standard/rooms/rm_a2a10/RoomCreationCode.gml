// Set world-map placement, liquid state, and the default footstep material.
global.mapoffsetx = 33;
global.mapoffsety = 22;
global.waterlevel = 0;
global.watertype = 0;
// Disable the player's contact checks against upward and downward mover objects.
global.moverobj = 0;
global.floormaterial = 3;

// Use item-room music when the optional music pack is available.
mus_change_itemroom();